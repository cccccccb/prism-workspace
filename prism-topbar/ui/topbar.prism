HStack(height: 38, spacing: 8, padding: 5, background: #141822E8) {
    Text("PRISM", width: 90, font: 16)
    Button("Apps", width: 84, action: "launcher:toggle", background: #34465FFF)
    Text($clock_time, width: 220, font: 16)
    Text($net_status, width: 130, font: 16)
    Text($bat_status, width: 90, font: 16)
    Button("Alerts", width: 80, action: "notifications:toggle", background: #34465FFF)
}
