                    InteractionTarget(action: "__prism_task_file_submit", height: 32, width: 88, visible: $__prism_task_file_normal, enabled: $__prism_task_file_submit_enabled) {
                        Visual(background: "@controlPrimary", cornerRadius: "@control_state_radius", borderWidth: 1, borderColor: "@controlOutline", paddingX: 8, justify: "center") {
                            Text($__prism_task_file_submit_caption, font: "@font_body", lineHeight: "@line_caption", foreground: "@controlPrimaryText", anchor: "center", overflow: "clip")
                        }
                        .state(when: "hovered", scope: "target", background: "@controlPrimaryHover")
                        .state(when: "pressed", scope: "target", background: "@controlPrimaryPressed")
                        .transition(property: "background", motion: "control.feedback")
                        Visual(cornerRadius: "@control_state_radius", borderWidth: 1, borderColor: "@controlFocus", opacity: 0)
                        .state(when: "focusVisible", scope: "target", opacity: 1)
                    }
                    InteractionTarget(action: "__prism_task_file_replace", height: 32, width: 88, visible: $__prism_task_file_overwrite, enabled: $__prism_task_file_submit_enabled) {
                        Visual(background: "@controlPrimary", cornerRadius: "@control_state_radius", borderWidth: 1, borderColor: "@controlOutline", paddingX: 8, justify: "center") {
                            Text("Replace", font: "@font_body", lineHeight: "@line_caption", foreground: "@controlPrimaryText", anchor: "center", overflow: "clip")
                        }
                        .state(when: "hovered", scope: "target", background: "@controlPrimaryHover")
                        .state(when: "pressed", scope: "target", background: "@controlPrimaryPressed")
                        .transition(property: "background", motion: "control.feedback")
                        Visual(cornerRadius: "@control_state_radius", borderWidth: 1, borderColor: "@controlFocus", opacity: 0)
                        .state(when: "focusVisible", scope: "target", opacity: 1)
                    }
                }
            }
        }
