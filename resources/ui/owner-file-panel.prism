                            InteractionTarget(action: "__prism_task_file_row_5", height: 32, visible: $__prism_task_file_row_5_visible, enabled: $__prism_task_file_nav_enabled) {
                                Visual(background: "@controlSecondary", cornerRadius: "@control_state_radius", borderWidth: 1, borderColor: "@controlOutline")
                                .state(when: "hovered", scope: "target", background: "@hover")
                                .state(when: "pressed", scope: "target", background: "@accentSoft")
                                .transition(property: "background", motion: "control.feedback")
                                Visual(background: "@accentSoft", cornerRadius: "@control_state_radius", visible: $__prism_task_file_row_5_selected)
                                HStack(spacing: 8, paddingX: 8, align: "center") {
                                    Icon("document", width: 16, height: 16, foreground: "@mutedText", visible: $__prism_task_file_row_5_file)
                                    Icon("folder", width: 16, height: 16, foreground: "@mutedText", visible: $__prism_task_file_row_5_directory)
