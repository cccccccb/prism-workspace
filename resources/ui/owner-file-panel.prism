                            Text($__prism_task_file_status, font: "@font_body", lineHeight: "@line_body", foreground: "@mutedText", overflow: "clip")
                        }
                        HStack(height: 32, spacing: 8, align: "center") {
                            InteractionTarget(action: "__prism_task_file_previous", height: 32, width: 32, enabled: $__prism_task_file_nav_enabled) {
                                Visual(background: "@controlSecondary", cornerRadius: "@control_state_radius", borderWidth: 1, borderColor: "@controlOutline", paddingX: 8, justify: "center") {
                                    Icon("arrow-left", width: 16, height: 16, foreground: "@text")
                                }
                                .state(when: "hovered", scope: "target", background: "@hover")
                                .state(when: "pressed", scope: "target", background: "@accentSoft")
                                .transition(property: "background", motion: "control.feedback")
                                Visual(cornerRadius: "@control_state_radius", borderWidth: 1, borderColor: "@controlFocus", opacity: 0)
                                .state(when: "focusVisible", scope: "target", opacity: 1)
                            }
                            Text($__prism_task_file_page_caption, width: 64, font: "@font_caption", lineHeight: "@line_caption", foreground: "@mutedText", anchor: "center", overflow: "clip")
                            InteractionTarget(action: "__prism_task_file_next", height: 32, width: 32, enabled: $__prism_task_file_nav_enabled) {
                                Visual(background: "@controlSecondary", cornerRadius: "@control_state_radius", borderWidth: 1, borderColor: "@controlOutline", paddingX: 8, justify: "center") {
                                    Icon("arrow-right", width: 16, height: 16, foreground: "@text")
                                }
                                .state(when: "hovered", scope: "target", background: "@hover")
                                .state(when: "pressed", scope: "target", background: "@accentSoft")
                                .transition(property: "background", motion: "control.feedback")
                                Visual(cornerRadius: "@control_state_radius", borderWidth: 1, borderColor: "@controlFocus", opacity: 0)
                                .state(when: "focusVisible", scope: "target", opacity: 1)
                            }
                        }
                        ScrollView(height: 44) {
                            Text($__prism_task_file_selected_caption, font: "@font_body", lineHeight: "@line_body", foreground: "@text", overflow: "clip")
                        }
                    }
                    Visual(scrollPart: "thumb", width: 3, height: 24, inset: 2, cornerRadius: 1.5, background: "@controlOutline")
                }
                TextField($__prism_task_file_filename, action: "__prism_task_file_name", height: 32, padding: 8, material: "control", font: "@font_body", lineHeight: "@line_caption", foreground: "@text", visible: $__prism_task_file_show_filename, enabled: $__prism_task_file_editing_enabled)
                HStack(height: 32, spacing: 8) {
                    InteractionTarget(action: "__prism_task_cancel", height: 32, width: 72) {
                        Visual(background: "@controlSecondary", cornerRadius: "@control_state_radius", borderWidth: 1, borderColor: "@controlOutline", paddingX: 8, justify: "center") {
                            Text("Cancel", font: "@font_body", lineHeight: "@line_caption", foreground: "@text", anchor: "center", overflow: "clip")
                        }
                        .state(when: "hovered", scope: "target", background: "@hover")
                        .state(when: "pressed", scope: "target", background: "@accentSoft")
                        .transition(property: "background", motion: "control.feedback")
                        Visual(cornerRadius: "@control_state_radius", borderWidth: 1, borderColor: "@controlFocus", opacity: 0)
                        .state(when: "focusVisible", scope: "target", opacity: 1)
                    }
                    Card(flex: 1)
                    InteractionTarget(action: "__prism_task_file_back", height: 32, width: 64, visible: $__prism_task_file_overwrite, enabled: $__prism_task_file_submit_enabled) {
                        Visual(background: "@controlSecondary", cornerRadius: "@control_state_radius", borderWidth: 1, borderColor: "@controlOutline", paddingX: 8, justify: "center") {
