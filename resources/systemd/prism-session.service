[Unit]
Description=Project Prism Wayland Compositor & Modern Desktop Environment
Documentation=https://github.com/chenbin/prism
BindsTo=graphical-session.target
Before=graphical-session.target
After=systemd-user-sessions.service

[Service]
Type=simple
Environment=XDG_CURRENT_DESKTOP=Prism
Environment=XDG_SESSION_TYPE=wayland
Environment=XDG_SESSION_DESKTOP=prism
ExecStart=/usr/bin/prism-session
Restart=on-failure
RestartSec=1s
TimeoutStopSec=5s

[Install]
WantedBy=graphical-session.target
