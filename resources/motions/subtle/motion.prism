MotionSet("subtle", version: 1) {
    Timing("spatial", durationMs: 160, easing: "easeInOutCubic")
    Timing("feedback", durationMs: 90, easing: "easeOutCubic")
    Timing("taskEnter", durationMs: 120, easing: "easeOutCubic")
    Timing("taskExit", durationMs: 100, easing: "easeInCubic")
    Transition("group.geometry", timing: "spatial")
    Transition("window.geometry", timing: "spatial")
    Transition("panel.visibility", timing: "feedback")
    Transition("control.feedback", timing: "feedback")
    Transition("task.open", timing: "taskEnter")
    Transition("task.close", timing: "taskExit")
}
