             innerShadowBlur: "@local_inner_shadow_blur", innerShadowY: "@inner_shadow_y", innerShadow: "@innerShadow", inputShape: "bounds")
    Layout(topbarSurfaceHeight: "@shell_top_height", dockSurfaceHeight: "@shell_bottom_height",
           dockMaxWidth: "@dock_width", outerGap: "@outer_gap", innerGap: "@inner_gap")
    Decoration("normal", shape: "window", enabled: true,
               borderWidth: "@window_border_width", border: "@border",
               shadowBlur: "@shadow_radius", shadowY: "@shadow_offset_y", shadow: "@shadow")
    Decoration("focused", shape: "window", enabled: true,
               borderWidth: "@window_border_width", border: "@accent",
               shadowBlur: "@shadow_radius", shadowY: "@shadow_offset_y", shadow: "@shadow")
    Decoration("fullscreen", shape: "window", enabled: false,
               borderWidth: 0, border: "@none", shadowBlur: 0, shadowY: 0, shadow: "@none")
    Controls(hover: "@hover", focus: "@focus", toggleKnob: "@toggleKnob",
             focusWidth: 2, toggleInset: 2, toggleKnobRadius: 9,
             toggleTrackRadius: 11, innerShadowY: "@inner_shadow_y")
