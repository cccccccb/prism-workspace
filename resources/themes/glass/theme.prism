             shadowBlur: "@panel_shadow_blur", shadowY: "@panel_shadow_y", shadow: "@shadow",
             innerShadowBlur: "@panel_inner_shadow_blur", innerShadowY: "@inner_shadow_y",
             innerShadow: "@innerShadow", inputShape: "bounds")
    Material("card", tint: "@cardTint", radius: "@card_radius", blur: 0,
