Theme("transparent", name: "Prism Transparent", schemaVersion: 1) {
    Number("topbar_height", value: 32)
    Number("shell_top_height", value: 52)
    Number("topbar_inset", value: 10)
    Number("dock_height", value: 76)
    Number("shell_bottom_height", value: 100)
    Number("dock_width", value: 620)
    Number("dock_bottom_inset", value: 12)
    Number("outer_gap", value: 14)
    Number("inner_gap", value: 12)
    Number("window_radius", value: 12)
    Number("window_border_width", value: 1)
    Number("shadow_radius", value: 18)
    Number("shadow_offset_y", value: 4)
    Number("panel_radius", value: 12)
    Number("card_radius", value: 10)
    Number("control_radius", value: 10)
    Number("icon_size", value: 24)
    Number("dock_icon_size", value: 44)
    Number("font_body", value: 14)
    Number("font_caption", value: 11)
    Number("font_heading", value: 22)
    Number("blur_radius", value: 0)
    Number("window_padding", value: 12)
    Number("panel_border_width", value: 1)
    Number("panel_shadow_blur", value: 10)
    Number("topbar_shadow_blur", value: 8)
    Number("panel_shadow_y", value: 2)
    Number("panel_inner_shadow_blur", value: 1)
    Number("inner_shadow_y", value: 1)
    Number("topbar_padding_x", value: 12)
    Number("topbar_padding_y", value: 5)
    Number("topbar_font", value: 13)
    Number("dock_panel_width", value: 340)
    Number("dock_padding", value: 8)
    Number("dock_spacing", value: 12)
    Number("dock_icon_padding", value: 9)
    Number("dock_label_font", value: 11)
    Number("status_font", value: 12)
    Number("button_size", value: 32)
    Number("button_padding", value: 7)
    Number("primary_button_width", value: 48)
    Number("primary_button_height", value: 44)
    Number("primary_button_padding", value: 10)
    Number("primary_shadow_blur", value: 4)
    Number("primary_shadow_y", value: 2)
    Number("track_font", value: 16)
    Number("progress_radius", value: 3)
    Number("indicator_radius", value: 1)
    Color("panelTint", value: #EDF2F500)
    Color("windowTint", value: #E7EDF100)
    Color("cardTint", value: #202B38A6)
    Color("controlTint", value: #405062BA)
    Color("border", value: #FFFFFFB2)
    Color("divider", value: #52677730)
    Color("text", value: #F2F6FAFF)
    Color("mutedText", value: #B8C6D4FF)
    Color("accent", value: #337BDFFF)
    Color("accentSoft", value: #337BDF24)
    Color("musicAccent", value: #EB5E79FF)
    Color("settingsAccent", value: #526B82FF)
    Color("shadow", value: #15283B40)
    Color("innerShadow", value: #22384C1C)
    Color("progressTrack", value: #52677730)
    Color("inactiveIndicator", value: #52677730)
    Color("onAccent", value: #FFFFFFFF)
    Color("desktopFallback", value: #182339FF)
    Color("none", value: #00000000)
    Color("hover", value: #FFFFFF1C)
    Color("focus", value: #78B4FFE6)
    Color("toggleKnob", value: #FFFFFFFF)
    Material("window", tint: "@windowTint", radius: "@window_radius", blur: "@blur_radius",
             borderWidth: 0, border: "@none", shadowBlur: 0, shadowY: 0, shadow: "@none",
             innerShadowBlur: 0, innerShadowY: 0, innerShadow: "@none", inputShape: "bounds")
    Material("panel", tint: "@panelTint", radius: "@panel_radius", blur: "@blur_radius",
             borderWidth: "@panel_border_width", border: "@border",
             shadowBlur: "@panel_shadow_blur", shadowY: "@panel_shadow_y", shadow: "@shadow",
             innerShadowBlur: "@panel_inner_shadow_blur", innerShadowY: "@inner_shadow_y",
             innerShadow: "@innerShadow", inputShape: "bounds")
    Material("card", tint: "@cardTint", radius: "@card_radius", blur: 0,
             borderWidth: 1, border: "@border", shadowBlur: 0, shadowY: 0, shadow: "@none",
             innerShadowBlur: 0, innerShadowY: 0, innerShadow: "@none", inputShape: "bounds")
    Material("control", tint: "@controlTint", radius: "@control_radius", blur: 0,
             borderWidth: 0, border: "@none", shadowBlur: 0, shadowY: 0, shadow: "@none",
             innerShadowBlur: 0, innerShadowY: 0, innerShadow: "@none", inputShape: "bounds")
    Layout(topbarSurfaceHeight: "@shell_top_height", dockSurfaceHeight: "@shell_bottom_height",
           dockMaxWidth: "@dock_width", outerGap: "@outer_gap", innerGap: "@inner_gap")
    Decoration("normal", shape: "window", enabled: true,
               borderWidth: "@window_border_width", border: "@border",
               shadowBlur: "@shadow_radius", shadowY: "@shadow_offset_y", shadow: "@shadow")
    Decoration("focused", shape: "window", enabled: true,
               borderWidth: "@window_border_width", border: "@accent",
               shadowBlur: "@shadow_radius", shadowY: "@shadow_offset_y", shadow: "@shadow")
    Decoration("fullscreen", shape: "window", enabled: false,
               borderWidth: 0, border: "@none", shadowBlur: 0, shadowY: 0, shadow: "@none")
    Controls(hover: "@hover", focus: "@focus", toggleKnob: "@toggleKnob",
             focusWidth: 2, toggleInset: 2, toggleKnobRadius: 9,
             toggleTrackRadius: 11, innerShadowY: "@inner_shadow_y")
}
