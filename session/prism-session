#!/usr/bin/env bash
# The supervisor owns WM/launcher; launcher assigns authorized host instances.
set -euo pipefail

case "${1:-}" in
    "") ;;
    --drm)
        export WLR_BACKENDS=drm,libinput
        unset DISPLAY WAYLAND_DISPLAY WAYLAND_SOCKET
        shift ;;
    --nested)
        if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
            export WLR_BACKENDS=wayland
        elif [[ -n "${DISPLAY:-}" ]]; then
            export WLR_BACKENDS=x11
        else
            echo 'prism-session: --nested requires an existing Wayland or X11 display' >&2
            exit 1
        fi
        shift ;;
    --help)
        echo 'Usage: prism-session [--drm|--nested]'
        echo 'Run --drm from a local login/seat session; remote demos use prism-demo@USER.service.'
        exit 0 ;;
    *) echo "prism-session: unknown argument: $1" >&2; exit 2 ;;
esac
[[ $# == 0 ]] || { echo 'prism-session: unexpected arguments' >&2; exit 2; }

export XDG_CURRENT_DESKTOP=Prism
export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=prism
export WLR_RENDERER="${WLR_RENDERER:-gles2}"
: "${XDG_RUNTIME_DIR:?prism-session requires XDG_RUNTIME_DIR from a login session}"
if [[ ! -d "$XDG_RUNTIME_DIR" || ! -O "$XDG_RUNTIME_DIR" || $(stat -c %a "$XDG_RUNTIME_DIR") != 700 ]]; then
    echo 'prism-session: runtime directory must be owned by this user with mode 0700' >&2
    exit 1
fi

# Pi exposes a VC4 display device separately from its V3D render node.
# Selecting the render node also gives EGL clients usable DMA-BUF feedback.
# Preserve explicit device choices and leave nested/headless sessions alone.
if [[ -z "${WLR_RENDER_DRM_DEVICE:-}" && -z "${WAYLAND_DISPLAY:-}" &&
      -z "${DISPLAY:-}" && "${WLR_BACKENDS:-}" != *headless* ]]; then
    for render_path in /sys/class/drm/renderD*; do
        driver_path=$(readlink -f "$render_path/device/driver") || continue
        if [[ ${driver_path##*/} == v3d ]]; then
            export WLR_RENDER_DRM_DEVICE="/dev/dri/${render_path##*/}"
            break
        fi
    done
fi

session_bin_dir=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
[[ -x "$session_bin_dir/prism-session-runtime" ]] || { echo 'prism-session: sibling prism-session-runtime binary is missing' >&2; exit 1; }
exec "$session_bin_dir/prism-session-runtime"
