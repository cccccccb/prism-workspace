VStack(spacing: 8, visible: $normal) {
    HStack(height: 32, spacing: 4, align: "center") {
        Text("Notes", flex: 1, font: "@font_title", foreground: "@text", overflow: "clip")
InteractionTarget(width: 32, height: 32, action: "new", cornerRadius: 8) {
        Visual(background: "@none", cornerRadius: 8, align: "center", justify: "center") { Icon("document-add", width: 18, height: 18, foreground: "@text") }
            .state(when: "hovered", scope: "target", background: "@hover")
            .state(when: "pressed", scope: "target", background: "@accentSoft", scaleX: 0.95, scaleY: 0.95)
            .transition(property: "background", motion: "control.feedback")
            .transition(property: "scaleX", motion: "control.feedback")
            .transition(property: "scaleY", motion: "control.feedback")
        Visual(cornerRadius: 8, borderWidth: 1.5, borderColor: "@accent", opacity: 0)
            .state(when: "focusVisible", scope: "target", opacity: 1)
            .transition(property: "opacity", motion: "control.feedback")
    }
InteractionTarget(width: 32, height: 32, action: "open-panel", cornerRadius: 8) {
        Visual(background: "@none", cornerRadius: 8, align: "center", justify: "center") { Icon("folder", width: 18, height: 18, foreground: "@text") }
            .state(when: "hovered", scope: "target", background: "@hover")
            .state(when: "pressed", scope: "target", background: "@accentSoft", scaleX: 0.95, scaleY: 0.95)
            .transition(property: "background", motion: "control.feedback")
            .transition(property: "scaleX", motion: "control.feedback")
            .transition(property: "scaleY", motion: "control.feedback")
        Visual(cornerRadius: 8, borderWidth: 1.5, borderColor: "@accent", opacity: 0)
            .state(when: "focusVisible", scope: "target", opacity: 1)
            .transition(property: "opacity", motion: "control.feedback")
    }
InteractionTarget(width: 32, height: 32, action: "save", cornerRadius: 8) {
        Visual(background: "@none", cornerRadius: 8, align: "center", justify: "center") { Icon("save", width: 18, height: 18, foreground: "@text") }
            .state(when: "hovered", scope: "target", background: "@hover")
            .state(when: "pressed", scope: "target", background: "@accentSoft", scaleX: 0.95, scaleY: 0.95)
            .transition(property: "background", motion: "control.feedback")
            .transition(property: "scaleX", motion: "control.feedback")
            .transition(property: "scaleY", motion: "control.feedback")
        Visual(cornerRadius: 8, borderWidth: 1.5, borderColor: "@accent", opacity: 0)
            .state(when: "focusVisible", scope: "target", opacity: 1)
            .transition(property: "opacity", motion: "control.feedback")
    }
InteractionTarget(width: 32, height: 32, action: "documents", cornerRadius: 8) {
        Visual(background: "@none", cornerRadius: 8, align: "center", justify: "center") { Icon("layers", width: 18, height: 18, foreground: "@text") }
            .state(when: "hovered", scope: "target", background: "@hover")
            .state(when: "pressed", scope: "target", background: "@accentSoft", scaleX: 0.95, scaleY: 0.95)
            .transition(property: "background", motion: "control.feedback")
            .transition(property: "scaleX", motion: "control.feedback")
            .transition(property: "scaleY", motion: "control.feedback")
        Visual(cornerRadius: 8, borderWidth: 1.5, borderColor: "@accent", opacity: 0)
            .state(when: "focusVisible", scope: "target", opacity: 1)
            .transition(property: "opacity", motion: "control.feedback")
    }
}
HStack(height: 36, spacing: 4) {
InteractionTarget(width: 24, height: 32, action: "page-previous", cornerRadius: 8, visible: $pages) {
        Visual(background: "@none", cornerRadius: 8, align: "center", justify: "center") { Icon("arrow-left", width: 18, height: 18, foreground: "@text") }
            .state(when: "hovered", scope: "target", background: "@hover")
            .state(when: "pressed", scope: "target", background: "@accentSoft", scaleX: 0.95, scaleY: 0.95)
            .transition(property: "background", motion: "control.feedback")
            .transition(property: "scaleX", motion: "control.feedback")
            .transition(property: "scaleY", motion: "control.feedback")
        Visual(cornerRadius: 8, borderWidth: 1.5, borderColor: "@accent", opacity: 0)
            .state(when: "focusVisible", scope: "target", opacity: 1)
            .transition(property: "opacity", motion: "control.feedback")
    }
Card(flex: 1, height: 36, visible: $tab_0, background: "@controlTint", cornerRadius: 8) {
        VStack(spacing: 0) {
            HStack(height: 32, spacing: 0) {
                InteractionTarget(flex: 1, height: 32, action: "select:0") {
                    Visual(paddingX: 6, justify: "center", cornerRadius: 8) {
                        Text($label_0, font: "@font_caption", foreground: "@text", overflow: "clip")
                    }
                        .state(when: "hovered", scope: "target", background: "@hover")
                        .transition(property: "background", motion: "control.feedback")
                    Visual(cornerRadius: 8, borderWidth: 1.5, borderColor: "@accent", opacity: 0)
                        .state(when: "focusVisible", scope: "target", opacity: 1)
                }
                InteractionTarget(width: 24, height: 32, action: "close:0", cornerRadius: 8) {
        Visual(background: "@none", cornerRadius: 8, align: "center", justify: "center") { Icon("close", width: 18, height: 18, foreground: "@text") }
            .state(when: "hovered", scope: "target", background: "@hover")
            .state(when: "pressed", scope: "target", background: "@accentSoft", scaleX: 0.95, scaleY: 0.95)
            .transition(property: "background", motion: "control.feedback")
            .transition(property: "scaleX", motion: "control.feedback")
            .transition(property: "scaleY", motion: "control.feedback")
        Visual(cornerRadius: 8, borderWidth: 1.5, borderColor: "@accent", opacity: 0)
            .state(when: "focusVisible", scope: "target", opacity: 1)
            .transition(property: "opacity", motion: "control.feedback")
    }
            }
            Card(height: 4, align: "center") {
                Card(width: 20, height: 4, cornerRadius: 2, background: "@accent", visible: $selected_0)
            }
        }
    }
