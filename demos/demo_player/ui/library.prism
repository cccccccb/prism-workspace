Card(material: "card", padding: 6, overflow: "clip") {
    VStack(spacing: 4, justify: "center") {
        Card(height: 38, material: "control", paddingX: 8, paddingY: 4, cornerRadius: 8, visible: $library_row_1) {
            HStack(spacing: 8, align: "center") {
                IconButton("play", "library:track:1", width: 24, height: 24, padding: 5,
                           material: "control", foreground: "@musicAccent")
                Icon("music", width: 16, height: 16, foreground: "@mutedText")
                VStack(flex: 1, spacing: 1, justify: "center") {
                    Text($library_title_1, font: "@font_body", foreground: "@text", overflow: "clip")
                    Text($library_artist_1, font: "@font_caption", foreground: "@mutedText", overflow: "clip")
                }
                Icon("heart", width: 14, height: 14, foreground: "@musicAccent")
                Text($library_duration_1, width: 36, font: "@font_caption", foreground: "@mutedText")
            }
        }
        Card(height: 38, material: "control", paddingX: 8, paddingY: 4, cornerRadius: 8, visible: $library_row_2) {
            HStack(spacing: 8, align: "center") {
                IconButton("play", "library:track:2", width: 24, height: 24, padding: 5,
                           material: "control", foreground: "@musicAccent")
                Icon("music", width: 16, height: 16, foreground: "@mutedText")
                VStack(flex: 1, spacing: 1, justify: "center") {
                    Text($library_title_2, font: "@font_body", foreground: "@text", overflow: "clip")
                    Text($library_artist_2, font: "@font_caption", foreground: "@mutedText", overflow: "clip")
                }
                Icon("heart", width: 14, height: 14, foreground: "@musicAccent")
                Text($library_duration_2, width: 36, font: "@font_caption", foreground: "@mutedText")
            }
        }
        Card(height: 38, material: "control", paddingX: 8, paddingY: 4, cornerRadius: 8, visible: $library_row_3) {
            HStack(spacing: 8, align: "center") {
                IconButton("play", "library:track:3", width: 24, height: 24, padding: 5,
                           material: "control", foreground: "@musicAccent")
                Icon("music", width: 16, height: 16, foreground: "@mutedText")
                VStack(flex: 1, spacing: 1, justify: "center") {
                    Text($library_title_3, font: "@font_body", foreground: "@text", overflow: "clip")
                    Text($library_artist_3, font: "@font_caption", foreground: "@mutedText", overflow: "clip")
                }
                Icon("heart", width: 14, height: 14, foreground: "@musicAccent")
                Text($library_duration_3, width: 36, font: "@font_caption", foreground: "@mutedText")
            }
        }
    }
}
