VStack(spacing: 6) {
    VStack(height: 38, spacing: 2, visible: $metadata_visible) {
        Text($track_title, height: 22, font: "@font_title", foreground: "@text", overflow: "clip")
        Text($track_artist, height: 14, font: "@font_caption", foreground: "@mutedText", overflow: "clip")
    }
    Progress(value: $playback_progress, height: "@indicator_height", cornerRadius: "@progress_radius",
             foreground: "@musicAccent", background: "@progressTrack")
        .transition(property: "value", durationMs: 180, easing: "easeOutCubic")
    HStack(height: 12, justify: "spaceBetween", align: "center", spacing: 0) {
        Text($playback_elapsed, font: "@font_caption", foreground: "@mutedText")
        Text($playback_duration, font: "@font_caption", foreground: "@mutedText")
    }
    HStack(height: 34, spacing: 10, align: "center", justify: "center") {
        IconButton("refresh", "player:repeat", width: 28, height: 28, padding: 6,
                   material: "control", foreground: "@text")
        IconButton("previous", "player:previous", width: 30, height: 30, padding: 6,
                   material: "control", foreground: "@text")
        IconButton($playback_icon, "player:toggle", width: 48, height: 32, padding: 7,
                   material: "control", foreground: "@onAccent", background: "@musicAccent")
        IconButton("next", "player:next", width: 30, height: 30, padding: 6,
                   material: "control", foreground: "@text")
        IconButton("heart", "player:favorite", width: 28, height: 28, padding: 6,
                   material: "control", foreground: "@musicAccent")
        Separator(width: 1, height: 16, background: "@divider")
        IconButton("volume", "player:volume_toggle", width: 26, height: 26, padding: 5,
                   material: "control", foreground: "@mutedText")
        Progress(value: $volume_level, width: 48, height: 4, cornerRadius: 2,
                 foreground: "@accent", background: "@progressTrack")
    }
}
