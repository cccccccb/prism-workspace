VStack(spacing: 4) {
    Progress(value: $playback_progress, height: 5, cornerRadius: 2.5, foreground: "@musicAccent", background: "@progressTrack")
    HStack(height: 36, spacing: 3, align: "center", justify: "spaceBetween") {
        InteractionTarget(action: "player:repeat", width: 28, height: 28) {
            Visual(cornerRadius: 6, align: "center", justify: "center") {
                Icon("repeat", width: 18, height: 18, anchor: "center", foreground: "@text", visible: $repeat_inactive)
                Icon("repeat", width: 18, height: 18, anchor: "center", foreground: "@accent", visible: $repeat_active)
            }
            .state(when: "hovered", scope: "target", background: "@hover")
            .transition(property: "background", motion: "control.feedback")
            Visual(cornerRadius: 6, borderWidth: 1, borderColor: "@accent", opacity: 0)
            .state(when: "focusVisible", scope: "target", opacity: 1)
        }
        IconButton("previous", "player:previous", width: 28, height: 28, padding: 5, foreground: "@text")
        IconButton($playback_icon, "player:toggle", width: 32, height: 32, padding: 6, foreground: "@onAccent", background: "@musicAccent", cornerRadius: 22)
        IconButton("next", "player:next", width: 28, height: 28, padding: 5, foreground: "@text")
        InteractionTarget(action: "player:favorite", width: 28, height: 28) {
            Visual(cornerRadius: 6, align: "center", justify: "center") {
                Icon("heart-outline", width: 18, height: 18, anchor: "center", foreground: "@text", visible: $favorite_inactive)
                Icon("heart", width: 18, height: 18, anchor: "center", foreground: "@musicAccent", visible: $favorite_active)
            }
            .state(when: "hovered", scope: "target", background: "@hover")
            .transition(property: "background", motion: "control.feedback")
            Visual(cornerRadius: 6, borderWidth: 1, borderColor: "@accent", opacity: 0)
            .state(when: "focusVisible", scope: "target", opacity: 1)
        }
        IconButton($volume_icon, "player:volume_toggle", width: 28, height: 28, padding: 5, foreground: "@text")
    }
}
