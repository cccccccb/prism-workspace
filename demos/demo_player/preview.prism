Card(padding: "@window_padding", material: "window", clip: true) {
    VStack(spacing: 10, justify: "center", align: "center") {
        Card(width: 72, height: 72, justify: "center", align: "center", material: "album") {
            Icon("music", width: 32, height: 32, foreground: "@musicAccent")
        }
        Text("Music", height: 22, font: "@font_title", foreground: "@text")
        Text("Preparing library", height: 14, font: "@font_caption", foreground: "@mutedText")
    }
}
