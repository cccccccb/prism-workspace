        Icon("music", width: 64, height: 64, foreground: "@musicAccent")
        Text("Music", height: 28, font: "@font_heading", foreground: "@text")
        Text("Preparing library", height: 18, font: "@font_body", foreground: "@mutedText")
    }
}
