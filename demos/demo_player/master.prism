Interface(version: 2, layout: "layout.prism") {
    Binding(name: "track_title", type: "string", initial: "Preparing library")
    Binding(name: "track_artist", type: "string", initial: "")
    Binding(name: "playback_elapsed", type: "string", initial: "0:00")
    Binding(name: "playback_duration", type: "string", initial: "0:00")
    Binding(name: "playback_icon", type: "string", initial: "play")
    Binding(name: "playback_progress", type: "number", initial: 0)
    Binding(name: "catalog_status", type: "string", initial: "Loading library")
    Binding(name: "catalog_pending", type: "bool", initial: true)
    Binding(name: "catalog_error", type: "bool", initial: false)
    Binding(name: "catalog_ready", type: "bool", initial: false)
    Binding(name: "artwork_visible", type: "bool", initial: true)
    Binding(name: "library_visible", type: "bool", initial: false)
    Binding(name: "metadata_visible", type: "bool", initial: true)
    Binding(name: "transport_height", type: "number", initial: 104)
    Binding(name: "track_1_active", type: "bool", initial: true)
    Binding(name: "track_2_active", type: "bool", initial: false)
    Binding(name: "track_3_active", type: "bool", initial: false)
    Binding(name: "volume_level", type: "number", initial: 0.8)
    Binding(name: "favorite_active", type: "bool", initial: true)
    Binding(name: "repeat_active", type: "bool", initial: false)
    Binding(name: "library_title_1", type: "string", initial: "")
    Binding(name: "library_artist_1", type: "string", initial: "")
    Binding(name: "library_duration_1", type: "string", initial: "")
    Binding(name: "library_row_1", type: "bool", initial: false)
    Binding(name: "library_title_2", type: "string", initial: "")
    Binding(name: "library_artist_2", type: "string", initial: "")
    Binding(name: "library_duration_2", type: "string", initial: "")
    Binding(name: "library_row_2", type: "bool", initial: false)
    Binding(name: "library_title_3", type: "string", initial: "")
    Binding(name: "library_artist_3", type: "string", initial: "")
    Binding(name: "library_duration_3", type: "string", initial: "")
    Binding(name: "library_row_3", type: "bool", initial: false)
    Component(id: "header", source: "ui/header.prism", phase: "critical")
    Component(id: "artwork", source: "ui/artwork.prism", phase: "critical")
    Component(id: "transport", source: "ui/transport.prism", phase: "critical")
    Component(id: "library", source: "ui/library.prism", phase: "deferred")
}
