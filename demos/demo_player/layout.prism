Card(padding: "@window_padding", material: "window", clip: true) {
    VStack(spacing: 6) {
        Slot(component: "header", height: 28)
        Slot(component: "artwork", flex: 1, visible: $artwork_visible)
        Slot(component: "library", flex: 1, visible: $library_visible) {
            Card(material: "card", padding: 6, overflow: "clip") {
                HStack(spacing: 8, align: "center", justify: "center") {
                    Icon("grid", width: 18, height: 18, foreground: "@musicAccent")
                    Text("Preparing track list", font: "@font_caption", foreground: "@mutedText")
                }
            }
        }
        Slot(component: "transport", height: $transport_height)
    }
}
