Card(material: "window", padding: "@window_padding") {
    VStack(spacing: 8, clip: true) {
        Card(height: 80, paddingX: 14, minViewportWidth: 600) {
            VStack(height: 80, spacing: 12) {
                HStack(height: 32, spacing: 12, align: "center") {
                    Icon("settings", width: 26, height: 26, foreground: "@text")
                    Text("Preferences", font: 24, foreground: "@text", flex: 1, overflow: "clip")
                    InteractionTarget(action: "prefs:menu:wide", width: 80, height: 32) {
                        Visual(background: "@controlSecondary", borderWidth: 1, borderColor: "@controlOutline", cornerRadius: "@control_state_radius", paddingX: 10, justify: "center") {
                            HStack(height: 20, spacing: 8, align: "center") {
                                Icon("grid", width: 18, height: 18, foreground: "@text")
                                Text("View", font: "@font_body", foreground: "@text", flex: 1, overflow: "clip")
                            }
                        }
                        .state(when: "hovered", scope: "target", background: "@hover")
                        .state(when: "pressed", scope: "target", background: "@accentSoft")
                        .transition(property: "background", motion: "control.feedback")
                        Visual(cornerRadius: "@control_state_radius", borderWidth: 1, borderColor: "@controlFocus", opacity: 0)
                        .state(when: "focusVisible", scope: "target", opacity: 1)
                    }
                }
                HStack(width: 416, height: 36, spacing: 8) {
                    VStack(flex: 1, spacing: 0) {
                        InteractionTarget(action: "page:performance", height: 33) {
                            Visual(cornerRadius: 6, justify: "center") {
                                HStack(spacing: 8, align: "center", justify: "center", minViewportWidth: 360) {
                                    Icon("monitor", width: 20, height: 20, foreground: "@text")
                                    Text("Overview", font: "@font_body", foreground: "@text", overflow: "clip")
                                }
                                Text("Overview", font: "@font_caption", foreground: "@text", overflow: "clip", anchor: "center", maxViewportWidth: 360)
                            }
                            .state(when: "hovered", scope: "target", background: "@hover")
                            .transition(property: "background", motion: "control.feedback")
                            Visual(cornerRadius: 6, borderWidth: 1, borderColor: "@accent", opacity: 0)
                            .state(when: "focusVisible", scope: "target", opacity: 1)
                        }
                        Card(height: 3, background: "@accent", cornerRadius: 1.5, visible: $page_performance)
                    }
                    VStack(flex: 1, spacing: 0) {
                        InteractionTarget(action: "page:appearance", height: 33) {
                            Visual(cornerRadius: 6, justify: "center") {
                                HStack(spacing: 8, align: "center", justify: "center", minViewportWidth: 360) {
                                    Icon("brush", width: 20, height: 20, foreground: "@text")
                                    Text("Appearance", font: "@font_body", foreground: "@text", overflow: "clip")
                                }
                                Text("Appearance", font: "@font_caption", foreground: "@text", overflow: "clip", anchor: "center", maxViewportWidth: 360)
                            }
                            .state(when: "hovered", scope: "target", background: "@hover")
                            .transition(property: "background", motion: "control.feedback")
                            Visual(cornerRadius: 6, borderWidth: 1, borderColor: "@accent", opacity: 0)
                            .state(when: "focusVisible", scope: "target", opacity: 1)
                        }
                        Card(height: 3, background: "@accent", cornerRadius: 1.5, visible: $page_appearance)
                    }
                    VStack(flex: 1, spacing: 0) {
                        InteractionTarget(action: "page:system", height: 33) {
                            Visual(cornerRadius: 6, justify: "center") {
                                HStack(spacing: 8, align: "center", justify: "center", minViewportWidth: 360) {
                                    Icon("activity", width: 20, height: 20, foreground: "@text")
                                    Text("Monitoring", font: "@font_body", foreground: "@text", overflow: "clip")
                                }
                                Text("Monitoring", font: "@font_caption", foreground: "@text", overflow: "clip", anchor: "center", maxViewportWidth: 360)
                            }
                            .state(when: "hovered", scope: "target", background: "@hover")
                            .transition(property: "background", motion: "control.feedback")
                            Visual(cornerRadius: 6, borderWidth: 1, borderColor: "@accent", opacity: 0)
                            .state(when: "focusVisible", scope: "target", opacity: 1)
                        }
                        Card(height: 3, background: "@accent", cornerRadius: 1.5, visible: $page_system)
                    }
                }
            }
        }
        Card(height: 80, maxViewportWidth: 600) {
            VStack(height: 80, spacing: 12) {
                HStack(height: 32, spacing: 12, align: "center") {
                    Icon("settings", width: 26, height: 26, foreground: "@text")
                    Text("Preferences", font: 24, foreground: "@text", flex: 1, overflow: "clip")
                    InteractionTarget(action: "prefs:menu:compact", width: 80, height: 32) {
                        Visual(background: "@controlSecondary", borderWidth: 1, borderColor: "@controlOutline", cornerRadius: "@control_state_radius", paddingX: 10, justify: "center") {
                            HStack(height: 20, spacing: 8, align: "center") {
                                Icon("grid", width: 18, height: 18, foreground: "@text")
                                Text("View", font: "@font_body", foreground: "@text", flex: 1, overflow: "clip")
                            }
                        }
                        .state(when: "hovered", scope: "target", background: "@hover")
                        .state(when: "pressed", scope: "target", background: "@accentSoft")
                        .transition(property: "background", motion: "control.feedback")
                        Visual(cornerRadius: "@control_state_radius", borderWidth: 1, borderColor: "@controlFocus", opacity: 0)
                        .state(when: "focusVisible", scope: "target", opacity: 1)
                    }
                }
                HStack(width: 416, height: 36, spacing: 8) {
                    VStack(flex: 1, spacing: 0) {
                        InteractionTarget(action: "page:performance", height: 33) {
                            Visual(cornerRadius: 6, justify: "center") {
                                HStack(spacing: 8, align: "center", justify: "center", minViewportWidth: 360) {
                                    Icon("monitor", width: 20, height: 20, foreground: "@text")
                                    Text("Overview", font: "@font_body", foreground: "@text", overflow: "clip")
                                }
                                Text("Overview", font: "@font_caption", foreground: "@text", overflow: "clip", anchor: "center", maxViewportWidth: 360)
                            }
                            .state(when: "hovered", scope: "target", background: "@hover")
                            .transition(property: "background", motion: "control.feedback")
                            Visual(cornerRadius: 6, borderWidth: 1, borderColor: "@accent", opacity: 0)
                            .state(when: "focusVisible", scope: "target", opacity: 1)
                        }
                        Card(height: 3, background: "@accent", cornerRadius: 1.5, visible: $page_performance)
                    }
                    VStack(flex: 1, spacing: 0) {
                        InteractionTarget(action: "page:appearance", height: 33) {
                            Visual(cornerRadius: 6, justify: "center") {
                                HStack(spacing: 8, align: "center", justify: "center", minViewportWidth: 360) {
                                    Icon("brush", width: 20, height: 20, foreground: "@text")
                                    Text("Appearance", font: "@font_body", foreground: "@text", overflow: "clip")
                                }
                                Text("Appearance", font: "@font_caption", foreground: "@text", overflow: "clip", anchor: "center", maxViewportWidth: 360)
                            }
                            .state(when: "hovered", scope: "target", background: "@hover")
                            .transition(property: "background", motion: "control.feedback")
                            Visual(cornerRadius: 6, borderWidth: 1, borderColor: "@accent", opacity: 0)
                            .state(when: "focusVisible", scope: "target", opacity: 1)
                        }
                        Card(height: 3, background: "@accent", cornerRadius: 1.5, visible: $page_appearance)
                    }
                    VStack(flex: 1, spacing: 0) {
                        InteractionTarget(action: "page:system", height: 33) {
                            Visual(cornerRadius: 6, justify: "center") {
                                HStack(spacing: 8, align: "center", justify: "center", minViewportWidth: 360) {
                                    Icon("activity", width: 20, height: 20, foreground: "@text")
                                    Text("Monitoring", font: "@font_body", foreground: "@text", overflow: "clip")
                                }
                                Text("Monitoring", font: "@font_caption", foreground: "@text", overflow: "clip", anchor: "center", maxViewportWidth: 360)
                            }
                            .state(when: "hovered", scope: "target", background: "@hover")
                            .transition(property: "background", motion: "control.feedback")
                            Visual(cornerRadius: 6, borderWidth: 1, borderColor: "@accent", opacity: 0)
                            .state(when: "focusVisible", scope: "target", opacity: 1)
                        }
                        Card(height: 3, background: "@accent", cornerRadius: 1.5, visible: $page_system)
                    }
                }
            }
        }
        Separator(height: 1, background: "@border")
        Card(flex: 1, visible: $theme_normal) {
            Card(paddingX: 14, minViewportWidth: 600, minViewportHeight: 540, visible: $page_performance) {
                VStack(spacing: 12) {
                    VStack(height: 146, spacing: 8) {
                        Text("Performance", font: "@font_title", foreground: "@text", overflow: "clip", height: 22)
                        Card(height: 116, paddingX: 10, background: "@controlTint", borderColor: "@border", borderWidth: 1, cornerRadius: 8) {
                            VStack(spacing: 0) {
                                HStack(height: 38, spacing: 10, align: "center") {
                                    Icon("cpu", width: 20, height: 20, foreground: "@text")
                                    Text("CPU", font: "@font_body", foreground: "@text", overflow: "clip", width: 70)
                                    Progress(value: $cpu_usage, flex: 1, height: 7, cornerRadius: 3.5, foreground: "@accent", background: "@progressTrack", minViewportWidth: 440)
                                    Card(flex: 1) {
                                        Text($cpu_usage_text, font: "@font_body", foreground: "@text", anchor: "right", overflow: "clip")
                                    }
                                }
                                Separator(height: 1, background: "@border")
                                HStack(height: 38, spacing: 10, align: "center") {
                                    Icon("memory", width: 20, height: 20, foreground: "@text")
                                    Text("Memory", font: "@font_body", foreground: "@text", overflow: "clip", width: 70)
                                    Progress(value: $memory_usage, flex: 1, height: 7, cornerRadius: 3.5, foreground: "@accent", background: "@progressTrack", minViewportWidth: 440)
                                    Card(flex: 1) {
                                        Text($mem_usage_text, font: "@font_body", foreground: "@text", anchor: "right", overflow: "clip")
                                    }
                                }
                                Separator(height: 1, background: "@border")
                                HStack(height: 38, spacing: 10, align: "center") {
                                    Icon("memory", width: 20, height: 20, foreground: "@text")
                                    Text("GPU", font: "@font_body", foreground: "@text", overflow: "clip", width: 70)
                                    Card(flex: 1) {
                                        Text($gpu_usage_text, font: "@font_body", foreground: "@text", anchor: "right", overflow: "clip")
                                    }
                                }
                            }
                        }
                    }
                    VStack(height: 107, spacing: 8) {
                        Text("Appearance", font: "@font_title", foreground: "@text", overflow: "clip", height: 22)
                        HStack(height: 77, spacing: 18, align: "center", minViewportWidth: 600) {
                            Card(width: 292, height: 77) {
                                HStack(height: 77, spacing: 12) {
                                    VStack(flex: 1, spacing: 5) {
                                        InteractionTarget(action: "theme:glass", height: 48) {
                                            Visual(cornerRadius: 7, clip: true) {
                                                Image("material_glass_dark.png", fit: "cover", visible: $scheme_dark_selected)
                                                Image("material_glass_light.png", fit: "cover", visible: $scheme_light_selected)
                                            }
                                            Visual(borderColor: "@border", borderWidth: 1, cornerRadius: 7)
                                            Visual(borderColor: "@accent", borderWidth: 1.5, cornerRadius: 7, visible: $theme_glass_selected)
                                            Visual(cornerRadius: 7, borderWidth: 1, borderColor: "@accent", opacity: 0)
                                            .state(when: "focusVisible", scope: "target", opacity: 1)
                                        }
                                        Card(height: 16) {
                                            Text("Glass", font: "@font_caption", foreground: "@text", overflow: "clip", anchor: "center")
                                        }
                                        Card(height: 3, cornerRadius: 1.5, background: "@accent", visible: $theme_glass_selected)
                                    }
                                    VStack(flex: 1, spacing: 5) {
                                        InteractionTarget(action: "theme:translucent", height: 48) {
                                            Visual(cornerRadius: 7, clip: true) {
                                                Image("material_tint_dark.png", fit: "cover", visible: $scheme_dark_selected)
                                                Image("material_tint_light.png", fit: "cover", visible: $scheme_light_selected)
                                            }
                                            Visual(borderColor: "@border", borderWidth: 1, cornerRadius: 7)
                                            Visual(borderColor: "@accent", borderWidth: 1.5, cornerRadius: 7, visible: $theme_translucent_selected)
                                            Visual(cornerRadius: 7, borderWidth: 1, borderColor: "@accent", opacity: 0)
                                            .state(when: "focusVisible", scope: "target", opacity: 1)
                                        }
                                        Card(height: 16) {
                                            Text("Tint", font: "@font_caption", foreground: "@text", overflow: "clip", anchor: "center")
                                        }
                                        Card(height: 3, cornerRadius: 1.5, background: "@accent", visible: $theme_translucent_selected)
                                    }
                                    VStack(flex: 1, spacing: 5) {
                                        InteractionTarget(action: "theme:transparent", height: 48) {
                                            Visual(cornerRadius: 7, clip: true) {
                                                Image("material_clear_dark.png", fit: "cover", visible: $scheme_dark_selected)
                                                Image("material_clear_light.png", fit: "cover", visible: $scheme_light_selected)
                                            }
                                            Visual(borderColor: "@border", borderWidth: 1, cornerRadius: 7)
                                            Visual(borderColor: "@accent", borderWidth: 1.5, cornerRadius: 7, visible: $theme_transparent_selected)
                                            Visual(cornerRadius: 7, borderWidth: 1, borderColor: "@accent", opacity: 0)
                                            .state(when: "focusVisible", scope: "target", opacity: 1)
                                        }
                                        Card(height: 16) {
                                            Text("Clear", font: "@font_caption", foreground: "@text", overflow: "clip", anchor: "center")
                                        }
                                        Card(height: 3, cornerRadius: 1.5, background: "@accent", visible: $theme_transparent_selected)
                                    }
                                    VStack(flex: 1, spacing: 5) {
                                        InteractionTarget(action: "theme:square", height: 48) {
                                            Visual(cornerRadius: 0, clip: true) {
                                                Image("material_square_dark.png", fit: "cover", visible: $scheme_dark_selected)
                                                Image("material_square_light.png", fit: "cover", visible: $scheme_light_selected)
                                            }
                                            Visual(borderColor: "@border", borderWidth: 1, cornerRadius: 0)
                                            Visual(borderColor: "@accent", borderWidth: 1.5, cornerRadius: 0, visible: $theme_square_selected)
                                            Visual(cornerRadius: 0, borderWidth: 1, borderColor: "@accent", opacity: 0)
                                            .state(when: "focusVisible", scope: "target", opacity: 1)
                                        }
                                        Card(height: 16) {
                                            Text("Square", font: "@font_caption", foreground: "@text", overflow: "clip", anchor: "center")
                                        }
                                        Card(height: 3, cornerRadius: 1.5, background: "@accent", visible: $theme_square_selected)
                                    }
                                }
                            }
                            Separator(width: 1, height: 64, background: "@border")
                            Card(height: 36, padding: 3, cornerRadius: 7, background: "@controlTint", borderWidth: 1, borderColor: "@border", width: 184) {
                                HStack(spacing: 2) {
                                    InteractionTarget(action: "appearance:light", flex: 1, height: 30) {
                                        Visual(cornerRadius: 5) {
                                        }
                                        .state(when: "hovered", scope: "target", background: "@hover")
                                        .transition(property: "background", motion: "control.feedback")
                                        Visual(background: "@accentSoft", borderColor: "@accent", borderWidth: 1, cornerRadius: 5, visible: $scheme_light_selected)
                                        Visual(justify: "center") {
                                            HStack(spacing: 6, align: "center", justify: "center") {
                                                Icon("sun", width: 18, height: 18, foreground: "@text")
                                                Text("Light", font: "@font_body", foreground: "@text", overflow: "clip")
                                            }
                                        }
                                        Visual(cornerRadius: 5, borderWidth: 1, borderColor: "@accent", opacity: 0)
                                        .state(when: "focusVisible", scope: "target", opacity: 1)
                                    }
                                    InteractionTarget(action: "appearance:dark", flex: 1, height: 30) {
                                        Visual(cornerRadius: 5) {
                                        }
                                        .state(when: "hovered", scope: "target", background: "@hover")
                                        .transition(property: "background", motion: "control.feedback")
                                        Visual(background: "@accentSoft", borderColor: "@accent", borderWidth: 1, cornerRadius: 5, visible: $scheme_dark_selected)
                                        Visual(justify: "center") {
                                            HStack(spacing: 6, align: "center", justify: "center") {
                                                Icon("moon", width: 18, height: 18, foreground: "@text")
                                                Text("Dark", font: "@font_body", foreground: "@text", overflow: "clip")
                                            }
                                        }
                                        Visual(cornerRadius: 5, borderWidth: 1, borderColor: "@accent", opacity: 0)
                                        .state(when: "focusVisible", scope: "target", opacity: 1)
                                    }
                                }
                            }
                        }
                        VStack(spacing: 10, maxViewportWidth: 600) {
                            HStack(height: 77, spacing: 12) {
                                VStack(flex: 1, spacing: 5) {
                                    InteractionTarget(action: "theme:glass", height: 48) {
                                        Visual(cornerRadius: 7, clip: true) {
                                            Image("material_glass_dark.png", fit: "cover", visible: $scheme_dark_selected)
                                            Image("material_glass_light.png", fit: "cover", visible: $scheme_light_selected)
                                        }
                                        Visual(borderColor: "@border", borderWidth: 1, cornerRadius: 7)
                                        Visual(borderColor: "@accent", borderWidth: 1.5, cornerRadius: 7, visible: $theme_glass_selected)
                                        Visual(cornerRadius: 7, borderWidth: 1, borderColor: "@accent", opacity: 0)
                                        .state(when: "focusVisible", scope: "target", opacity: 1)
                                    }
                                    Card(height: 16) {
                                        Text("Glass", font: "@font_caption", foreground: "@text", overflow: "clip", anchor: "center")
                                    }
                                    Card(height: 3, cornerRadius: 1.5, background: "@accent", visible: $theme_glass_selected)
                                }
                                VStack(flex: 1, spacing: 5) {
                                    InteractionTarget(action: "theme:translucent", height: 48) {
                                        Visual(cornerRadius: 7, clip: true) {
                                            Image("material_tint_dark.png", fit: "cover", visible: $scheme_dark_selected)
                                            Image("material_tint_light.png", fit: "cover", visible: $scheme_light_selected)
                                        }
                                        Visual(borderColor: "@border", borderWidth: 1, cornerRadius: 7)
                                        Visual(borderColor: "@accent", borderWidth: 1.5, cornerRadius: 7, visible: $theme_translucent_selected)
                                        Visual(cornerRadius: 7, borderWidth: 1, borderColor: "@accent", opacity: 0)
                                        .state(when: "focusVisible", scope: "target", opacity: 1)
                                    }
                                    Card(height: 16) {
                                        Text("Tint", font: "@font_caption", foreground: "@text", overflow: "clip", anchor: "center")
                                    }
                                    Card(height: 3, cornerRadius: 1.5, background: "@accent", visible: $theme_translucent_selected)
                                }
                                VStack(flex: 1, spacing: 5) {
                                    InteractionTarget(action: "theme:transparent", height: 48) {
                                        Visual(cornerRadius: 7, clip: true) {
                                            Image("material_clear_dark.png", fit: "cover", visible: $scheme_dark_selected)
                                            Image("material_clear_light.png", fit: "cover", visible: $scheme_light_selected)
                                        }
                                        Visual(borderColor: "@border", borderWidth: 1, cornerRadius: 7)
                                        Visual(borderColor: "@accent", borderWidth: 1.5, cornerRadius: 7, visible: $theme_transparent_selected)
                                        Visual(cornerRadius: 7, borderWidth: 1, borderColor: "@accent", opacity: 0)
                                        .state(when: "focusVisible", scope: "target", opacity: 1)
                                    }
                                    Card(height: 16) {
                                        Text("Clear", font: "@font_caption", foreground: "@text", overflow: "clip", anchor: "center")
                                    }
                                    Card(height: 3, cornerRadius: 1.5, background: "@accent", visible: $theme_transparent_selected)
                                }
                                VStack(flex: 1, spacing: 5) {
                                    InteractionTarget(action: "theme:square", height: 48) {
                                        Visual(cornerRadius: 0, clip: true) {
                                            Image("material_square_dark.png", fit: "cover", visible: $scheme_dark_selected)
                                            Image("material_square_light.png", fit: "cover", visible: $scheme_light_selected)
                                        }
                                        Visual(borderColor: "@border", borderWidth: 1, cornerRadius: 0)
                                        Visual(borderColor: "@accent", borderWidth: 1.5, cornerRadius: 0, visible: $theme_square_selected)
                                        Visual(cornerRadius: 0, borderWidth: 1, borderColor: "@accent", opacity: 0)
                                        .state(when: "focusVisible", scope: "target", opacity: 1)
                                    }
                                    Card(height: 16) {
                                        Text("Square", font: "@font_caption", foreground: "@text", overflow: "clip", anchor: "center")
                                    }
                                    Card(height: 3, cornerRadius: 1.5, background: "@accent", visible: $theme_square_selected)
                                }
                            }
                            Card(height: 36, padding: 3, cornerRadius: 7, background: "@controlTint", borderWidth: 1, borderColor: "@border", width: 184) {
                                HStack(spacing: 2) {
                                    InteractionTarget(action: "appearance:light", flex: 1, height: 30) {
                                        Visual(cornerRadius: 5) {
                                        }
                                        .state(when: "hovered", scope: "target", background: "@hover")
                                        .transition(property: "background", motion: "control.feedback")
                                        Visual(background: "@accentSoft", borderColor: "@accent", borderWidth: 1, cornerRadius: 5, visible: $scheme_light_selected)
                                        Visual(justify: "center") {
                                            HStack(spacing: 6, align: "center", justify: "center") {
                                                Icon("sun", width: 18, height: 18, foreground: "@text")
                                                Text("Light", font: "@font_body", foreground: "@text", overflow: "clip")
                                            }
                                        }
                                        Visual(cornerRadius: 5, borderWidth: 1, borderColor: "@accent", opacity: 0)
                                        .state(when: "focusVisible", scope: "target", opacity: 1)
                                    }
                                    InteractionTarget(action: "appearance:dark", flex: 1, height: 30) {
                                        Visual(cornerRadius: 5) {
                                        }
                                        .state(when: "hovered", scope: "target", background: "@hover")
                                        .transition(property: "background", motion: "control.feedback")
                                        Visual(background: "@accentSoft", borderColor: "@accent", borderWidth: 1, cornerRadius: 5, visible: $scheme_dark_selected)
                                        Visual(justify: "center") {
                                            HStack(spacing: 6, align: "center", justify: "center") {
                                                Icon("moon", width: 18, height: 18, foreground: "@text")
                                                Text("Dark", font: "@font_body", foreground: "@text", overflow: "clip")
                                            }
                                        }
                                        Visual(cornerRadius: 5, borderWidth: 1, borderColor: "@accent", opacity: 0)
                                        .state(when: "focusVisible", scope: "target", opacity: 1)
                                    }
                                }
                            }
                        }
                    }
                    VStack(height: 105, spacing: 8) {
                        Text("Monitoring", font: "@font_title", foreground: "@text", overflow: "clip", height: 22)
                        Card(height: 75, paddingX: 10, background: "@controlTint", borderWidth: 1, borderColor: "@border", cornerRadius: 8) {
                            VStack(spacing: 0) {
                                HStack(height: 36, spacing: 10, align: "center") {
                                    Icon("activity", width: 20, height: 20, foreground: "@text")
                                    Text("Monitor", font: "@font_body", foreground: "@text", overflow: "clip", flex: 1)
                                    Toggle(checked: $monitoring_active, action: "monitor:toggle", width: 44, height: 24, cornerRadius: 12, foreground: "@accent", background: "@progressTrack")
                                }
                                Separator(height: 1, background: "@border")
                                HStack(height: 36, spacing: 10, align: "center") {
                                    Card(width: 20, minViewportWidth: 600) {
                                        Icon("clock", width: 20, height: 20, foreground: "@text")
                                    }
                                    Text("Sample interval", font: "@font_body", foreground: "@text", overflow: "clip", width: 116, minViewportWidth: 440)
                                    Card(height: 36, padding: 3, cornerRadius: 7, background: "@controlTint", borderWidth: 1, borderColor: "@border", flex: 1) {
                                        HStack(spacing: 2) {
                                            InteractionTarget(action: "sampling:500", flex: 1, height: 30) {
                                                Visual(cornerRadius: 5) {
                                                }
                                                .state(when: "hovered", scope: "target", background: "@hover")
                                                .transition(property: "background", motion: "control.feedback")
                                                Visual(background: "@accentSoft", borderColor: "@accent", borderWidth: 1, cornerRadius: 5, visible: $interval_500_selected)
                                                Visual(justify: "center") {
                                                    HStack(spacing: 6, align: "center", justify: "center") {
                                                        Text("0.5s", font: "@font_body", foreground: "@text", overflow: "clip")
                                                    }
                                                }
                                                Visual(cornerRadius: 5, borderWidth: 1, borderColor: "@accent", opacity: 0)
                                                .state(when: "focusVisible", scope: "target", opacity: 1)
                                            }
                                            InteractionTarget(action: "sampling:1000", flex: 1, height: 30) {
                                                Visual(cornerRadius: 5) {
                                                }
                                                .state(when: "hovered", scope: "target", background: "@hover")
                                                .transition(property: "background", motion: "control.feedback")
                                                Visual(background: "@accentSoft", borderColor: "@accent", borderWidth: 1, cornerRadius: 5, visible: $interval_1000_selected)
                                                Visual(justify: "center") {
                                                    HStack(spacing: 6, align: "center", justify: "center") {
                                                        Text("1s", font: "@font_body", foreground: "@text", overflow: "clip")
                                                    }
                                                }
                                                Visual(cornerRadius: 5, borderWidth: 1, borderColor: "@accent", opacity: 0)
                                                .state(when: "focusVisible", scope: "target", opacity: 1)
                                            }
                                            InteractionTarget(action: "sampling:2000", flex: 1, height: 30) {
                                                Visual(cornerRadius: 5) {
                                                }
                                                .state(when: "hovered", scope: "target", background: "@hover")
                                                .transition(property: "background", motion: "control.feedback")
                                                Visual(background: "@accentSoft", borderColor: "@accent", borderWidth: 1, cornerRadius: 5, visible: $interval_2000_selected)
                                                Visual(justify: "center") {
                                                    HStack(spacing: 6, align: "center", justify: "center") {
                                                        Text("2s", font: "@font_body", foreground: "@text", overflow: "clip")
                                                    }
                                                }
                                                Visual(cornerRadius: 5, borderWidth: 1, borderColor: "@accent", opacity: 0)
                                                .state(when: "focusVisible", scope: "target", opacity: 1)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Text("Metrics unavailable are shown as —.", height: 16, font: "@font_caption", foreground: "@mutedText", overflow: "clip")
                }
            }
