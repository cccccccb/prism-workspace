Card(padding: "@window_padding", material: "window", clip: true) {
    VStack(spacing: 8) {
        HStack(height: 32, spacing: 8, align: "center") {
            Icon("settings", width: 24, height: 24, foreground: "@text")
            Text("Preferences", flex: 1, font: "@font_heading", foreground: "@text")
            IconButton("refresh", "sys:refresh", width: "@button_size", height: "@button_size", padding: "@button_padding",
                       material: "control", foreground: "@text")
        }
        VStack(flex: 1, spacing: 4, padding: 6, justify: "center", material: "card") {
            HStack(height: 18, spacing: 8, align: "center") {
                Icon("cpu", width: 18, height: 18, foreground: "@accent")
                Text($cpu_usage_text, flex: 1, font: "@status_font", foreground: "@text", overflow: "clip")
            }
            Progress(value: $cpu_usage, height: 4, cornerRadius: "@progress_radius",
                     foreground: "@accent", background: "@progressTrack")
        }
        VStack(flex: 1, spacing: 4, padding: 6, justify: "center", material: "card") {
            HStack(height: 18, spacing: 8, align: "center") {
                Icon("memory", width: 18, height: 18, foreground: "@settingsAccent")
                Text($mem_usage_text, flex: 1, font: "@status_font", foreground: "@text", overflow: "clip")
            }
            Progress(value: $memory_usage, height: 4, cornerRadius: "@progress_radius",
                     foreground: "@settingsAccent", background: "@progressTrack")
        }
        VStack(height: 48, spacing: 4, padding: 4, material: "card") {
            HStack(height: 24, spacing: 4) {
                Button("Glass", "theme:glass", flex: 1, height: 24, font: "@font_caption",
                       material: "control", foreground: "@text")
                Button("Tint", "theme:translucent", flex: 1, height: 24, font: "@font_caption",
                       material: "control", foreground: "@text")
                Button("Clear", "theme:transparent", flex: 1, height: 24, font: "@font_caption",
                       material: "control", foreground: "@text")
                Button("Square", "theme:square", flex: 1, height: 24, font: "@font_caption",
                       material: "control", foreground: "@text")
            }
            Text($theme_status, height: 12, font: "@font_caption", foreground: "@mutedText", overflow: "clip")
        }
    }
}
