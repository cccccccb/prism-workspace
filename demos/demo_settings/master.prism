VStack(spacing: 18, padding: 28, background: #172030FF) {
    Text("SYSTEM MONITOR", font: 24)
    Card(height: 72, padding: 12, background: #25334AFF) {
        Text($cpu_usage_text, font: 18)
    }
    Card(height: 72, padding: 12, background: #25334AFF) {
        Text($mem_usage_text, font: 18)
    }
    HStack(height: 64, spacing: 16) {
        Button($dark_mode_btn, action: "theme:toggle", background: #365675FF)
        Button("Purge RAM Cache", action: "sys:purge", background: #365675FF)
    }
}
