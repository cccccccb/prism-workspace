Card(padding: "@window_padding", material: "window", clip: true) {
    VStack(spacing: 6) {
        HStack(height: 28, spacing: 6, align: "center") {
            Icon("settings", width: 20, height: 20, foreground: "@settingsAccent")
            Text("Preferences", flex: 1, font: "@font_body", foreground: "@text", overflow: "clip")
            Card(width: 28, height: 28, justify: "end") {
                IconButton("cpu", "page:performance", height: 28, padding: 6,
                           material: "control", foreground: "@text")
                Progress(value: 1, width: 12, height: 2, anchor: "center", cornerRadius: "@indicator_radius",
                         foreground: "@indicator", visible: $page_performance)
            }
            Card(width: 28, height: 28, justify: "end") {
                IconButton("layers", "page:appearance", height: 28, padding: 6,
                           material: "control", foreground: "@text")
                Progress(value: 1, width: 12, height: 2, anchor: "center", cornerRadius: "@indicator_radius",
                         foreground: "@indicator", visible: $page_appearance)
            }
            IconButton("refresh", "sys:refresh", width: 28, height: 28, padding: 6,
                       material: "control", foreground: "@text")
        }
        VStack(flex: 1, spacing: 6, visible: $page_performance) {
            HStack(height: 18, spacing: 6, align: "center") {
                Text("Performance", flex: 1, font: "@font_caption", foreground: "@mutedText")
                Text("Monitor", width: 42, font: "@font_caption", foreground: "@mutedText")
                Toggle(checked: $monitoring_active, action: "monitor:toggle", width: 34, height: 18,
                       foreground: "@accent", background: "@progressTrack")
            }
            Card(flex: 1, padding: 6, material: "card") {
                VStack(spacing: 4) {
                    Card(flex: 1, justify: "center") {
                        HStack(height: 34, spacing: 5, align: "center") {
                            Icon("cpu", width: 24, height: 24, foreground: "@accent")
                            Text("CPU", width: 54, font: "@font_caption", foreground: "@mutedText")
                            Text($cpu_usage_text, flex: 1, font: "@font_caption", foreground: "@text", overflow: "clip")
                            Progress(value: $cpu_usage, width: 38, height: 4, cornerRadius: "@progress_radius",
                                     foreground: "@accent", background: "@progressTrack")
                        }
                    }
                    Card(flex: 1, justify: "center") {
                        HStack(height: 34, spacing: 5, align: "center") {
                            Icon("memory", width: 24, height: 24, foreground: "@settingsAccent")
                            Text("Memory", width: 54, font: "@font_caption", foreground: "@mutedText")
                            Text($mem_usage_text, flex: 1, font: "@font_caption", foreground: "@text", overflow: "clip")
                            Progress(value: $memory_usage, width: 38, height: 4, cornerRadius: "@progress_radius",
                                     foreground: "@settingsAccent", background: "@progressTrack")
                        }
                    }
                    Card(flex: 1, justify: "center") {
                        HStack(height: 34, spacing: 5, align: "center") {
                            Icon("rectangle", width: 24, height: 24, foreground: "@accent")
                            Text("GPU", width: 54, font: "@font_caption", foreground: "@mutedText")
                            Text($gpu_usage_text, flex: 1, font: "@font_caption", foreground: "@text", overflow: "clip")
                            Progress(value: $gpu_busy, width: 38, height: 4, cornerRadius: "@progress_radius",
                                     foreground: "@accent", background: "@progressTrack", visible: $gpu_busy_available)
                        }
                    }
                    Text($hardware_aux, height: 12, font: "@font_caption", foreground: "@mutedText",
                         overflow: "clip", visible: $hardware_aux_visible)
                }
            }
            HStack(height: 28, spacing: 4, align: "center") {
                Text("Sample", width: 42, font: "@font_caption", foreground: "@mutedText")
                VStack(flex: 1, spacing: 2, align: "center") {
                    Button("0.5s", action: "sampling:500", height: 24, font: "@font_caption", padding: 4,
                           material: "control", foreground: "@text")
                    Progress(value: 1, width: 16, height: 2, cornerRadius: "@indicator_radius",
                             foreground: "@indicator", visible: $interval_500_selected)
                }
                VStack(flex: 1, spacing: 2, align: "center") {
                    Button("1s", action: "sampling:1000", height: 24, font: "@font_caption", padding: 4,
                           material: "control", foreground: "@text")
                    Progress(value: 1, width: 16, height: 2, cornerRadius: "@indicator_radius",
                             foreground: "@indicator", visible: $interval_1000_selected)
                }
                VStack(flex: 1, spacing: 2, align: "center") {
                    Button("2s", action: "sampling:2000", height: 24, font: "@font_caption", padding: 4,
                           material: "control", foreground: "@text")
                    Progress(value: 1, width: 16, height: 2, cornerRadius: "@indicator_radius",
                             foreground: "@indicator", visible: $interval_2000_selected)
                }
            }
        }
        VStack(flex: 1, spacing: 6, visible: $page_appearance) {
            Text("Appearance", height: 18, font: "@font_caption", foreground: "@mutedText")
            Card(flex: 1, padding: 6, material: "card") {
                VStack(spacing: 6) {
                    Card(flex: 1, justify: "center") {
                        HStack(height: 96, spacing: 10, align: "stretch") {
                            VStack(flex: 1, spacing: 2, align: "center") {
                                Card(flex: 1, justify: "center", align: "center") {
                                    IconButton("layers", "theme:glass", width: 56, height: 56, padding: 6,
                                               anchor: "center", material: "control", foreground: "@text")
                                }
                                Text("Glass", height: 12, font: "@font_caption", foreground: "@mutedText")
                                Card(height: "@indicator_height", justify: "center", align: "center") {
                                    Progress(value: 1, width: 16, height: "@indicator_height", cornerRadius: "@indicator_radius",
                                             foreground: "@indicator", visible: $theme_glass_selected)
                                }
                            }
                            VStack(flex: 1, spacing: 2, align: "center") {
                                Card(flex: 1, justify: "center", align: "center") {
                                    IconButton("drop", "theme:translucent", width: 56, height: 56, padding: 6,
                                               anchor: "center", material: "control", foreground: "@text")
                                }
                                Text("Tint", height: 12, font: "@font_caption", foreground: "@mutedText")
                                Card(height: "@indicator_height", justify: "center", align: "center") {
                                    Progress(value: 1, width: 16, height: "@indicator_height", cornerRadius: "@indicator_radius",
                                             foreground: "@indicator", visible: $theme_translucent_selected)
                                }
                            }
                            VStack(flex: 1, spacing: 2, align: "center") {
                                Card(flex: 1, justify: "center", align: "center") {
                                    IconButton("rectangle", "theme:transparent", width: 56, height: 56, padding: 6,
                                               anchor: "center", material: "control", foreground: "@text")
                                }
                                Text("Clear", height: 12, font: "@font_caption", foreground: "@mutedText")
                                Card(height: "@indicator_height", justify: "center", align: "center") {
                                    Progress(value: 1, width: 16, height: "@indicator_height", cornerRadius: "@indicator_radius",
                                             foreground: "@indicator", visible: $theme_transparent_selected)
                                }
                            }
                            VStack(flex: 1, spacing: 2, align: "center") {
                                Card(flex: 1, justify: "center", align: "center") {
                                    IconButton("grid", "theme:square", width: 56, height: 56, padding: 6,
                                               anchor: "center", material: "control", foreground: "@text")
                                }
                                Text("Square", height: 12, font: "@font_caption", foreground: "@mutedText")
                                Card(height: "@indicator_height", justify: "center", align: "center") {
                                    Progress(value: 1, width: 16, height: "@indicator_height", cornerRadius: "@indicator_radius",
                                             foreground: "@indicator", visible: $theme_square_selected)
                                }
                            }
                        }
                    }
                    HStack(height: 30, spacing: 8, align: "center") {
                        HStack(flex: 1, spacing: 4, align: "center") {
                            IconButton("sun", "appearance:light", width: 34, height: 30, padding: 6,
                                       material: "control", foreground: "@text")
                            Text("Light", flex: 1, font: "@font_caption", foreground: "@mutedText")
                            Icon("check", width: 12, height: 12, foreground: "@indicator", visible: $scheme_light_selected)
                        }
                        HStack(flex: 1, spacing: 4, align: "center") {
                            IconButton("moon", "appearance:dark", width: 34, height: 30, padding: 6,
                                       material: "control", foreground: "@text")
                            Text("Dark", flex: 1, font: "@font_caption", foreground: "@mutedText")
                            Icon("check", width: 12, height: 12, foreground: "@indicator", visible: $scheme_dark_selected)
                        }
                    }
                    Text($theme_status, height: 12, font: "@font_caption", foreground: "@mutedText",
                         overflow: "clip", visible: $theme_error_visible)
                }
            }
        }
    }
}
