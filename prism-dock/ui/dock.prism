Card(height: "@shell_bottom_height", padding: "@dock_bottom_inset") {
    HStack(width: "@dock_panel_width", height: "@dock_height", anchor: "center", spacing: "@dock_spacing",
           padding: "@dock_padding", align: "center", justify: "center", material: "panel") {
        VStack(width: 58, height: 60, spacing: 1, align: "center") {
            IconButton("music", "app:launch:music", width: "@dock_icon_size", height: "@dock_icon_size",
                       padding: "@dock_icon_padding", material: "control", foreground: "@musicAccent",
                       borderWidth: "@panel_border_width", borderColor: "@border")
            Text("Music", height: 11, font: "@font_caption", foreground: "@text")
            Progress(value: $music_running, width: 14, height: 2, cornerRadius: "@indicator_radius",
                     foreground: "@musicAccent", background: "@inactiveIndicator")
        }
        Separator(width: 1, height: 42, background: "@divider")
        VStack(width: 58, height: 60, spacing: 1, align: "center") {
            IconButton("settings", "app:launch:settings", width: "@dock_icon_size", height: "@dock_icon_size",
                       padding: "@dock_icon_padding", material: "control", foreground: "@settingsAccent",
                       borderWidth: "@panel_border_width", borderColor: "@border")
            Text("Pref", height: 11, font: "@font_caption", foreground: "@text")
            Progress(value: $settings_running, width: 14, height: 2, cornerRadius: "@indicator_radius",
                     foreground: "@settingsAccent", background: "@inactiveIndicator")
        }
        VStack(flex: 1, spacing: 5, justify: "center", overflow: "clip") {
            Text($running_badge, font: "@font_caption", foreground: "@mutedText")
            Text($launch_status, font: "@status_font", foreground: "@text")
        }
    }
}
