HStack(height: 72, spacing: 8, padding: 8, background: #181C26E8) {
    Button("Apps", width: 72, action: "dock:launcher", background: #34465FFF)
    Button("Files", width: 76, action: "app:launch:files", background: #34465FFF)
    Button("Term", width: 76, action: "app:launch:terminal", background: #34465FFF)
    Button("Web", width: 76, action: "app:launch:browser", background: #34465FFF)
    Button("Code", width: 76, action: "app:launch:editor", background: #34465FFF)
    Button("Music", width: 76, action: "app:launch:music", background: #34465FFF)
    Button("Pref", width: 76, action: "app:launch:settings", background: #34465FFF)
    Text($running_badge, width: 120, font: 15)
}
